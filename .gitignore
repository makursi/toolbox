# dependencies
node_modules/
# pnpm resolves its content-addressable store relative to the project, and a clean
# install (`node_modules` deleted first) can leave one at the repository root before it
# settles under `node_modules/`. It is a cache of everything ever installed — 1105
# files of it, measured — and one `git add -A` sweeps it into the index.
.pnpm-store/

# build output
.next/
out/
dist/
build/

# turborepo
.turbo/

# playwright: a failure's trace belongs on the machine that failed, not in git
test-results/
playwright-report/
blob-report/

# vercel
.vercel/

# env files (opt-in via .env.example)
.env
.env.*
!.env.example

# image assets waiting to be processed: a drop box, only its README is tracked
apps/web/assets/inbox/*
!apps/web/assets/inbox/README.md

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# os / editors
.DS_Store
Thumbs.db
.idea/
# .vscode is local preference, except the extension list, which is a courtesy to
# whoever clones this next: `antfu.iconify` is what previews and completes the
# `icon-[ph--sun-bold]` class names.
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# agent tooling (kept out of git), except the project's own skills
.agents/*
!.agents/skills/
!.agents/skills/**
.claude/
skills-lock.json
