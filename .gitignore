# dependencies
node_modules/

# build output
.next/
out/
dist/
build/

# turborepo
.turbo/

# playwright: a failure's trace belongs on the machine that failed, not in git
test-results/
playwright-report/
blob-report/

# vercel
.vercel/

# env files (opt-in via .env.example)
.env
.env.*
!.env.example

# image assets waiting to be processed: a drop box, only its README is tracked
apps/web/assets/inbox/*
!apps/web/assets/inbox/README.md

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# os / editors
.DS_Store
Thumbs.db
.idea/
# .vscode is local preference, except the extension list, which is a courtesy to
# whoever clones this next: `antfu.iconify` is what previews and completes the
# `icon-[ph--sun-bold]` class names.
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# agent tooling (kept out of git)
.agents/
.claude/
skills-lock.json
